    <!-- ════════════════════════════════════════════════════════════════
         PeerLink palette — fixed LIGHT theme. Gold + orange are the heroes,
         silver-grey is the structure, red/blue/green are sparse accents only.
         (No dark mode, no light/dark toggle — one designed look.)
         ════════════════════════════════════════════════════════════════ -->
    <color name="peerlink_canvas">#ECEEF0</color>   <!-- app background — light silver -->
    <color name="peerlink_surface">#FFFFFF</color>  <!-- cards / raised surfaces -->
    <color name="peerlink_surface_alt">#F4F6F8</color>
    <color name="peerlink_gold">#F0BE43</color>     <!-- signature -->
    <color name="peerlink_gold_deep">#C9961F</color>
    <color name="peerlink_orange">#FB8C3A</color>   <!-- signature -->
    <color name="peerlink_orange_deep">#E26A1A</color>
    <color name="peerlink_silver">#9AA1AA</color>   <!-- brushed-metal mid grey -->
    <color name="peerlink_silver_line">#D7DBDF</color> <!-- borders / dividers -->
    <color name="peerlink_graphite">#2C2F36</color> <!-- primary text -->
    <color name="peerlink_graphite_soft">#5A616B</color> <!-- secondary text -->
    <color name="peerlink_muted">#8A929C</color>    <!-- hint text -->
    <color name="peerlink_red">#E0556E</color>      <!-- accent — danger -->
    <color name="peerlink_blue">#3E8FD4</color>     <!-- accent — info -->
    <color name="peerlink_green">#2EA56A</color>    <!-- accent — success -->

